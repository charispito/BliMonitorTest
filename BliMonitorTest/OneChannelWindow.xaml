<Window x:Class="BliMonitorTest.OneChannelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BliMonitorTest"
        xmlns:controls="clr-namespace:BliMonitorTest.controls"
        mc:Ignorable="d"
        Title="BLI 모니터링 프로그램"
        Height="900"
        Width="1915"
        SizeToContent="Width"
        Background="Transparent">

    <!-- 바깥: 그라데이션 배경 -->
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <!-- 바깥 여백 -->
            <Grid Margin="18" ShowGridLines="False">
                <!-- 전체를 큰 카드로 감싸서 "앱 프레임" 느낌 -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                    <Grid ShowGridLines="False">

                        <!-- ✅ Row=3/Row=5 비율 조정으로 차트 영역 확대 -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="14"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="850"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                        </Grid.ColumnDefinitions>

                        <!-- 상단 설정/연결 영역 -->
                        <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="900"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="바탕화면 저장" FontSize="16" VerticalContentAlignment="Center" HorizontalAlignment="Right" Margin="10,0" x:Name="SaveCheck"/>
                                <Label Grid.Column="5" Margin="0,0,20,0" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" FontSize="16" x:Name="VersionText"/>

                                <!-- Save File Name -->
                                <Border Grid.Row="1" Grid.Column="1" Padding="8" BorderThickness="1" BorderBrush="{StaticResource SoftBorderBrush}" CornerRadius="10" Background="#FBFDFF">
                                    <WrapPanel>
                                        <Label Content="Save File Name" FontSize="16" VerticalContentAlignment="Center" FontWeight="Black"/>
                                        <TextBox FontSize="17" FontWeight="Black" Width="680" VerticalContentAlignment="Center" x:Name="FileName"/>
                                    </WrapPanel>
                                </Border>
                                <controls:LabeledCombobox x:Name="PortList" Title="COM" Grid.Column="2" Margin="10,0"/>
                                <Button Grid.Column="3" Content="연결" Width="86" x:Name="ConnectButton" Style="{StaticResource TopActionButtonStyle}" Padding="0"/>
                                <Button Grid.Column="4" Content="갱신" Width="86" Margin="10,0" x:Name="RefreshButton" Style="{StaticResource TopActionButtonStyle}" Background="#0EA5E9" Padding="0"/>
                                <Label Grid.Column="5" Content="2022.02.01 ver 1.0.0" FontWeight="Black" Visibility="Hidden"/>
                                <ComboBox x:Name="DummyInterfaceCombo" Grid.Row="0" Grid.Column="5" Width="120" Margin="123,0,12,0" Style="{StaticResource PrettyComboBoxStyle}">
                                    <ComboBoxItem Content="상태 요청" Tag="3"/>
                                </ComboBox>

                                <CheckBox x:Name="UseDummyCheck" Grid.Column="5" Margin="15,0,170,0" VerticalAlignment="Center" Width="70" Content="더미" Checked="UseDummyCheck_Checked" Unchecked="UseDummyCheck_Unchecked"/>
                            </Grid>
                        </Border>

                        <!-- 중간 상세 영역 -->
                        <Border Grid.Row="3"
                                Grid.Column="1"
                                Style="{StaticResource CardBorderStyle}"
                                Margin="0,0,12,12">
                            <controls:OneChannelValueDetail x:Name="channel"/>
                        </Border>

                        <Border Grid.Row="3"
                                Grid.Column="2"
                                Style="{StaticResource CardBorderStyle}"
                                Margin="12,0,0,12">
                            <controls:SingleDetail x:Name="DetailView" Margin="0"/>
                        </Border>

                        <!-- ✅ 차트 영역: Row=5가 2*라서 더 커짐 -->
                        <Border Grid.Column="1"
                                Grid.Row="5"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource CardBorderStyle}">
                            <controls:OxyView x:Name="Chart"/>
                        </Border>

                    </Grid>
                </Border>

            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
