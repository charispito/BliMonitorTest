<Window x:Class="BliMonitorTest.OneChannelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BliMonitorTest"
        xmlns:controls="clr-namespace:BliMonitorTest.controls"
        mc:Ignorable="d"
        Title="BLI 모니터링 프로그램"
        Height="1100"
        Width="1900"
        SizeToContent="Manual"
        Background="Transparent">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid Margin="12">
                <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="14"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="20"/>
                        </Grid.ColumnDefinitions>

                        <!-- 상단 -->
                        <Border Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="8" Margin="0,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="900"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Content="바탕화면 저장" FontSize="16" VerticalContentAlignment="Center" HorizontalAlignment="Right" Margin="0,1,79,-2" x:Name="SaveCheck"/>
                                <Label Grid.Column="5" Margin="0,0,20,0" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" FontSize="16" x:Name="VersionText" Visibility="Hidden"/>

                                <Border Grid.Row="1" Grid.Column="1" Padding="8" BorderThickness="1" BorderBrush="{StaticResource SoftBorderBrush}" CornerRadius="10" Background="#FBFDFF">
                                    <WrapPanel HorizontalAlignment="Center">
                                        <Label Content="Save File Name" FontSize="16" VerticalContentAlignment="Center" FontWeight="Black"/>
                                        <TextBox FontSize="16" FontWeight="Black" Width="680" VerticalContentAlignment="Center" x:Name="FileName" Margin="5,0,0,0"/>
                                    </WrapPanel>
                                </Border>

                                <controls:LabeledCombobox x:Name="PortList" Title="COM" Grid.Column="2" Margin="10,0"/>
                                <Button Grid.Column="3" Content="연결" Width="86" x:Name="ConnectButton" Style="{StaticResource SoftButtonStyle}" Padding="0" Margin="0,0,0,8" VerticalAlignment="Bottom"/>
                                <Button Grid.Column="4" Content="갱신" Width="86" Margin="13,0" x:Name="RefreshButton" Style="{StaticResource SoftButtonStyle}" Padding="0"/>
                                <ComboBox x:Name="DummyInterfaceCombo" Grid.Row="0" Grid.Column="5" Width="120" Margin="123,0,12,0" Style="{StaticResource PrettyComboBoxStyle}">
                                    <ComboBoxItem Content="상태 요청" Tag="3"/>
                                </ComboBox>
                                <CheckBox x:Name="UseDummyCheck" Grid.Column="5" Margin="15,0,170,0" VerticalAlignment="Center" Width="70" Content="더미" Checked="UseDummyCheck_Checked" Unchecked="UseDummyCheck_Unchecked"/>
                            </Grid>
                        </Border>

                        <!-- 좌측 메인 상태 -->
                        <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                            <controls:OneChannelValueDetail x:Name="channel"/>
                        </Border>

                        <!-- 우측 버튼 정보 -->
                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top" Grid.ColumnSpan="2" Margin="10,12,0,0" Grid.RowSpan="3" Height="597">
                            <controls:SingleDetail x:Name="DetailView" Margin="0,6,0,5"/>
                        </Border>

                        <!-- 차트 -->
                        <Border Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="4" Style="{StaticResource CardBorderStyle}" Margin="0,10,0,10" Grid.RowSpan="3">
                            <controls:OxyView x:Name="Chart" Margin="0,0,0,-5"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
