<Window x:Class="BliMonitorTest.OneChannelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BliMonitorTest"
        xmlns:controls="clr-namespace:BliMonitorTest.controls"
        mc:Ignorable="d"
        Title="BLI 모니터링 프로그램"
        Height="800"
        Width="1904"
        SizeToContent="Width"
        Background="Transparent">

    <Window.Resources>

        <!-- ComboBox 텍스트/항목 센터 정렬 -->
        <Style x:Key="CenterAlignedComboBox" TargetType="ComboBox">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 배경 그라데이션 -->
        <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EAF4FF" Offset="0"/>
            <GradientStop Color="#DDEEFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- 카드 그림자 -->
        <DropShadowEffect x:Key="CardShadow"
                          Color="#000000"
                          BlurRadius="18"
                          ShadowDepth="2"
                          Opacity="0.16"/>

        <!-- 카드(Border) 공통 -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- 얇은 테두리(입력 박스 영역 등) -->
        <SolidColorBrush x:Key="SoftBorderBrush" Color="#E5E7EB"/>

        <!-- ✅ 상단 액션 버튼(연결/갱신) - 높이 줄인 버전 -->
        <Style x:Key="TopActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- 바깥: 그라데이션 배경 -->
    <Grid Background="{StaticResource AppBackgroundBrush}">

        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">

            <!-- 바깥 여백 -->
            <Grid Margin="18" ShowGridLines="False">

                <!-- 전체를 큰 카드로 감싸서 "앱 프레임" 느낌 -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                    <Grid ShowGridLines="False">

                        <!-- ✅ Row=3/Row=5 비율 조정으로 차트 영역 확대 -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="14"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="850"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                        </Grid.ColumnDefinitions>

                        <!-- 상단 설정/연결 영역 -->
                        <Border Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Grid.Row="1"
                                Style="{StaticResource CardBorderStyle}"
                                Padding="8"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="900"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Content="바탕화면 저장"
                                          FontSize="16"
                                          VerticalContentAlignment="Center"
                                          HorizontalAlignment="Right"
                                          Margin="10,0"
                                          x:Name="SaveCheck"/>

                                <Label Grid.Column="5"
                                       Margin="0,0,20,0"
                                       HorizontalContentAlignment="Right"
                                       VerticalContentAlignment="Center"
                                       FontSize="16"
                                       x:Name="VersionText"/>

                                <!-- Save File Name -->
                                <Border Grid.Row="1"
                                        Grid.Column="1"
                                        Padding="8"
                                        BorderThickness="1"
                                        BorderBrush="{StaticResource SoftBorderBrush}"
                                        CornerRadius="10"
                                        Background="#FBFDFF">
                                    <WrapPanel>
                                        <Label Content="Save File Name"
                                               FontSize="16"
                                               VerticalContentAlignment="Center"
                                               FontWeight="Black"/>
                                        <TextBox FontSize="17"
                                                 FontWeight="Black"
                                                 Width="680"
                                                 VerticalContentAlignment="Center"
                                                 x:Name="FileName"/>
                                    </WrapPanel>
                                </Border>

                                <controls:LabeledCombobox x:Name="PortList"
                                                         Title="COM"
                                                         Grid.Column="2"
                                                         Margin="10,0"/>

                                <Button Grid.Column="3"
                                        Content="연결"
                                        Width="86"
                                        x:Name="ConnectButton"
                                        Style="{StaticResource TopActionButtonStyle}"
                                        Padding="0"/>

                                <Button Grid.Column="4"
                                        Content="갱신"
                                        Width="86"
                                        Margin="10,0"
                                        x:Name="RefreshButton"
                                        Style="{StaticResource TopActionButtonStyle}"
                                        Background="#0EA5E9"
                                        Padding="0"/>

                                <Label Grid.Column="5"
                                       Content="2022.02.01 ver 1.0.0"
                                       FontWeight="Black"
                                       Visibility="Hidden"/>

                                <ComboBox x:Name="DummyInterfaceCombo"
                                          Grid.Row="0"
                                          Grid.Column="5"
                                          Width="120"
                                          Margin="123,0,12,0"
                                          Style="{StaticResource CenterAlignedComboBox}">
                                    <ComboBoxItem Content="상태 요청" Tag="3"/>
                                </ComboBox>

                                <CheckBox x:Name="UseDummyCheck"
                                          Grid.Column="5"
                                          Margin="15,0,170,0"
                                          VerticalAlignment="Center"
                                          Width="70"
                                          Content="더미"
                                          Checked="UseDummyCheck_Checked"
                                          Unchecked="UseDummyCheck_Unchecked"/>
                            </Grid>
                        </Border>

                        <!-- 중간 상세 영역 -->
                        <Border Grid.Row="3"
                                Grid.Column="1"
                                Style="{StaticResource CardBorderStyle}"
                                Margin="0,0,12,12">
                            <controls:OneChannelValueDetail x:Name="channel"/>
                        </Border>

                        <Border Grid.Row="3"
                                Grid.Column="2"
                                Style="{StaticResource CardBorderStyle}"
                                Margin="12,0,0,12">
                            <controls:SingleDetail x:Name="DetailView" Margin="0"/>
                        </Border>

                        <!-- ✅ 차트 영역: Row=5가 2*라서 더 커짐 -->
                        <Border Grid.Column="1"
                                Grid.Row="5"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource CardBorderStyle}">
                            <controls:OxyView x:Name="Chart"/>
                        </Border>

                    </Grid>
                </Border>

            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
