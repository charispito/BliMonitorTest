<Window x:Class="BliMonitorTest.MultiWindow1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BliMonitorTest" xmlns:controls="clr-namespace:BliMonitorTest.controls"
        mc:Ignorable="d"
        Title="BLI 모니터링 프로그램" Height="900" Width="1915" WindowStartupLocation="CenterScreen" Background="Transparent">

    <Window.Resources>

    </Window.Resources>

    <!-- 바깥: 그라데이션 배경 -->
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <!-- 바깥 여백 -->
            <Grid Margin="18" ShowGridLines="False">
                <!-- 전체를 큰 카드로 감싸서 "앱 프레임" 느낌 -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                    <Grid ShowGridLines="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="205"/>
                            <RowDefinition Height="205"/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition Height="20"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="900"/>
                            <ColumnDefinition Width="900"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                        </Grid.ColumnDefinitions>

                        <!-- 상단 설정/연결 영역 -->
                        <Border Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource CardBorderStyle}" Padding="8" Margin="0,18,0,12" Height="55" Grid.RowSpan="2">
                            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Height="55">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="900"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Content="바탕화면 저장" FontSize="16" VerticalContentAlignment="Center" Margin="19,-7,107,6" x:Name="SaveCheck"/>
                                <Label Grid.Column="5" Margin="0,5,20,5" HorizontalContentAlignment="Right" VerticalContentAlignment="top" FontSize="16" x:Name="VersionText"/>

                                <!-- Save File Name -->
                                <Border Grid.Column="1" Padding="0" BorderThickness="1" BorderBrush="{StaticResource SoftBorderBrush}" CornerRadius="10" Background="#FBFDFF" Margin="0,0,0,16" >
                                    <WrapPanel Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,0" HorizontalAlignment="Center">
                                        <Label Content="Save File Name " FontSize="16" VerticalContentAlignment="Center" FontWeight="Black" Height="35"/>
                                        <TextBox FontSize="16" FontWeight="Black" Width="678" VerticalContentAlignment="Center" x:Name="FileName" Margin="5,0,0,0"/>
                                    </WrapPanel>
                                </Border>

                                <Button Grid.Column="3" Content="시작" Width="86" Margin="10,0,10,16" x:Name="StartButton" Style="{StaticResource SoftButtonStyle}" Padding="0"/>
                                <Button Grid.Column="4" Content="정지" Width="86" x:Name="StopButton" Style="{StaticResource SoftButtonStyle}" Padding="0" Margin="0,0,0,16"/>
                                <TextBox Visibility="Hidden" x:Name="FileNameBox" VerticalContentAlignment="Center" Grid.Column="2" Width="700" BorderBrush="Black" BorderThickness="1" Margin="10, 0"/>
                                <Label Visibility="Hidden" Grid.Column="1" Content="Save File Name" FontSize="16"/>
                            </Grid>
                        </Border>

                        <controls:ChannelItem Grid.Row="2" Grid.Column="1" x:Name="Item1"/>
                        <controls:ChannelItem Grid.Row="2" Grid.Column="2" x:Name="Item2"/>
                        <controls:ChannelItem Grid.Row="3" Grid.Column="1" x:Name="Item3"/>
                        <controls:ChannelItem Grid.Row="3" Grid.Column="2" x:Name="Item4"/>
                        <controls:OxyView  x:Name="Chart" Grid.Row="4" Grid.RowSpan="2" Grid.Column="1" Grid.ColumnSpan="3"/>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
