<UserControl x:Class="BliMonitorTest.controls.SingleDetail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:BliMonitorTest.controls"
             mc:Ignorable="d"
             d:DesignWidth="420"
             d:DesignHeight="300">

    <Border Margin="6"
            BorderBrush="#AAA"
            BorderThickness="1"
            Background="#FFF"
            Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="버튼 상태"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="#111827"
                       Margin="4,0,0,2"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                </Grid.RowDefinitions>

                <local:DoubleLabel Grid.Row="0" Grid.Column="0" x:Name="DL0" Margin="4,2"/>
                <local:DoubleLabel Grid.Row="1" Grid.Column="0" x:Name="DL1" Margin="4,2"/>
                <local:DoubleLabel Grid.Row="2" Grid.Column="0" x:Name="DL2" Margin="4,2"/>
                <local:DoubleLabel Grid.Row="3" Grid.Column="0" x:Name="DL3" Margin="4,2"/>
                <local:DoubleLabel Grid.Row="4" Grid.Column="0" x:Name="DL4" Margin="4,2"/>
                <local:DoubleLabel Grid.Row="5" Grid.Column="0" x:Name="DL5" Margin="4,2"/>

                <local:DoubleLabel Grid.Row="0" Grid.Column="1" x:Name="DL6" Margin="4,2"/>
                <local:DoubleLabel Grid.Row="1" Grid.Column="1" x:Name="DL7" Margin="4,2"/>
                <local:DoubleLabel Grid.Row="2" Grid.Column="1" x:Name="DL8" Margin="4,2"/>
                <local:DoubleLabel Grid.Row="3" Grid.Column="1" x:Name="DL9" Margin="4,2"/>
                <local:DoubleLabel Grid.Row="4" Grid.Column="1" x:Name="DL10" Margin="4,2"/>
                <local:DoubleLabel Grid.Row="5" Grid.Column="1" x:Name="DL11" Margin="4,2"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
