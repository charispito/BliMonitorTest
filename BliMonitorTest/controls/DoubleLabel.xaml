<UserControl x:Class="BliMonitorTest.controls.DoubleLabel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="230">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label FontSize="13" Padding="0" VerticalContentAlignment="Center" FontWeight="Bold" HorizontalContentAlignment="Center" Foreground="Black" BorderBrush="#AAA" BorderThickness="1" x:Name="label" Background="#652822E8"/>
        <Label HorizontalContentAlignment="Center" Padding="0" VerticalContentAlignment="Center" Background="#FFF" FontSize="13" Grid.Column="1" BorderBrush="#AAA" BorderThickness="0,1,1,1" x:Name="cont"/>
    </Grid>
</UserControl>
