<UserControl x:Class="BliMonitorTest.controls.OxyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf"
             xmlns:local="clr-namespace:BliMonitorTest.controls"
             mc:Ignorable="d"
             Background="#FFF"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>

        <!-- 미니 아이콘 버튼(좁은 영역용) -->
        <Style x:Key="MiniIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0F111827"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1F111827"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 아이콘 텍스트(윈도우 내장 폰트: Segoe MDL2 Assets) -->
        <Style x:Key="IconGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Border Margin="2" BorderBrush="#AAA" BorderThickness="1">
        <Grid ShowGridLines="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label FontSize="13"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   x:Name="Channel"
                   FontWeight="Black"/>

            <oxy:PlotView DefaultTrackerTemplate="{x:Null}"
                          Model="{Binding PlotModel}"
                          x:Name="chart"
                          Background="#FFF"
                          Grid.Row="1"
                          Grid.RowSpan="1"
                          BorderThickness="0"
                          Padding="0,0,2,0"
                          Margin="0,0,0,8"/>

            <!-- 하단 범례 + 버튼 영역 -->
            <Grid Margin="20,0,20,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Background="Red" Height="10" Width="10" VerticalAlignment="Center"/>
                <Label VerticalContentAlignment="Center" Grid.Column="1" FontSize="13" Name="series1Legend" MaxWidth="100"/>

                <Label Background="Blue" Grid.Column="2" Height="10" Width="10" VerticalAlignment="Center"/>
                <Label VerticalContentAlignment="Center" Grid.Column="3" FontSize="13" Name="series2Legend" MaxWidth="100"/>

                <Label Background="#FFD0AF12" Grid.Column="4" Height="10" Width="10" VerticalAlignment="Center"/>
                <Label VerticalContentAlignment="Center" Grid.Column="5" FontSize="13" Name="series3Legend" MaxWidth="100"/>

                <Label Background="DeepSkyBlue" Grid.Column="6" Height="10" Width="10" VerticalAlignment="Center"/>
                <Label VerticalContentAlignment="Center" Grid.Column="7" FontSize="13" Name="series4Legend" MaxWidth="100"/>

                <Label Background="Magenta" Grid.Column="8" Height="10" Width="10" VerticalAlignment="Center"/>
                <Label VerticalContentAlignment="Center" Grid.Column="9" FontSize="13" Name="series5Legend" MaxWidth="100"/>

                <Label Background="SpringGreen" Grid.Column="10" Height="10" Width="10" VerticalAlignment="Center"/>
                <Label VerticalContentAlignment="Center" Grid.Column="11" FontSize="13" Name="series6Legend" MaxWidth="100"/>

                <Label Background="Green" Grid.Column="12" Height="10" Width="10" VerticalAlignment="Center"/>
                <Label VerticalContentAlignment="Center" Grid.Column="13" FontSize="13" Name="series7Legend" MaxWidth="100"/>

                <Label Background="Black" Grid.Column="14" Height="10" Width="10" VerticalAlignment="Center"/>
                <Label VerticalContentAlignment="Center" Grid.Column="15" FontSize="13" Name="series8Legend" MaxWidth="100"/>

                <!-- ✅ 예쁜 리셋 버튼 (아이콘) -->
                <Button Grid.Column="16"
                        Margin="8,0,4,0"
                        VerticalAlignment="Center"
                        Click="ResetAxes_Click"
                        Style="{StaticResource MiniIconButtonStyle}"
                        ToolTip="축 리셋">
                    <!-- 'Refresh' 느낌 아이콘 -->
                    <TextBlock Style="{StaticResource IconGlyphStyle}" Text=""/>
                </Button>

                <!-- ✅ 여기 추가: 차트 초기화 버튼 -->
                <Button Grid.Column="17"
                    Margin="4,0,4,0"
                    VerticalAlignment="Center"
                    Click="ClearChart_Click"
                    Style="{StaticResource MiniIconButtonStyle}"
                    ToolTip="차트 초기화(데이터 삭제)">
                    <TextBlock Style="{StaticResource IconGlyphStyle}" Text="&#xE107;"/>
                </Button>

                <!-- ✅ 예쁜 전체 버튼 (아이콘) -->
                <Button Grid.Column="18"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Click="ToggleFullscreen_Click"
                        Style="{StaticResource MiniIconButtonStyle}"
                        ToolTip="전체 화면">
                    <!-- 'Full screen' 느낌 아이콘 -->
                    <TextBlock Style="{StaticResource IconGlyphStyle}" Text=""/>
                </Button>

                <Button Grid.Column="19"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Click="BtnOpenDb_Click"
                        Style="{StaticResource MiniIconButtonStyle}"
                        ToolTip="데이터 조회">
                    <TextBlock Style="{StaticResource IconGlyphStyle}" Text="▶▶"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1"
                  VerticalAlignment="Bottom"
                  Width="Auto"
                  Margin="5,0,0,0"
                  HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <!--
                <Label Content="(A)" Foreground="Magenta" FontSize="11" Padding="2,2"/>
                -->
                <Label Content="(상태)" Grid.Column="1" Foreground="Blue" FontSize="11" Padding="2,2"/>
                <Label Content="(ºC)" Grid.Column="2" Foreground="Red" FontSize="11" Padding="2,2"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
