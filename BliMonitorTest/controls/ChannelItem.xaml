<UserControl x:Class="BliMonitorTest.controls.ChannelItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BliMonitorTest.controls"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="800">
    <Border Margin="6" BorderBrush="#000" BorderThickness="1" Background="#FFF">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="1" Color="#CFCFCF" Direction="315"/>
        </Border.Effect>
        <Grid ShowGridLines="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition Width="5"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="5"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="5"/>
            </Grid.RowDefinitions>
            <local:DoubleLabel Grid.Row="1" Grid.Column="2" Margin="5, 3" x:Name="Item1"/>
            <local:DoubleLabel Grid.Row="2" Grid.Column="2" Margin="5, 3" x:Name="Item2"/>
            <local:DoubleLabel Grid.Row="3" Grid.Column="2" Margin="5, 3" x:Name="Item3"/>
            <local:DoubleLabel Grid.Row="4" Grid.Column="2" Margin="5, 3" x:Name="Item4"/>
            <local:DoubleLabel Grid.Row="5" Grid.Column="2" Margin="5, 3" x:Name="Item5"/>
            <local:DoubleLabel Grid.Row="6" Grid.Column="2" Margin="5, 3" x:Name="Item6"/>
            <CheckBox x:Name="Item1Check" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"/>
            <CheckBox x:Name="Item2Check" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"/>
            <CheckBox x:Name="Item3Check" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center"/>
            <CheckBox x:Name="Item4Check" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center"/>

            <local:DoubleLabel Grid.Row="1" Grid.Column="4" Margin="5, 3" x:Name="Item11"/>
            <local:DoubleLabel Grid.Row="2" Grid.Column="4" Margin="5, 3" x:Name="Item12"/>
            <local:DoubleLabel Grid.Row="3" Grid.Column="4" Margin="5, 3" x:Name="Item13"/>
            <local:DoubleLabel Grid.Row="4" Grid.Column="4" Margin="5, 3" x:Name="Item14"/>
            <local:DoubleLabel Grid.Row="5" Grid.Column="4" Margin="5, 3" x:Name="Item15"/>
            <local:DoubleLabel Grid.Row="6" Grid.Column="4" Margin="5, 3" x:Name="Item16"/>
            <CheckBox x:Name="Item5Check" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center"/>
            <CheckBox x:Name="Item6Check" Grid.Row="2" Grid.Column="3" VerticalAlignment="Center"/>
            <CheckBox x:Name="Item7Check" Grid.Row="3" Grid.Column="3" VerticalAlignment="Center"/>
            <CheckBox x:Name="Item8Check" Grid.Row="4" Grid.Column="3" VerticalAlignment="Center"/>
            <Label Grid.Row="2" Grid.RowSpan="2" Grid.Column="5" Margin="5,3" BorderBrush="#000" BorderThickness="1" x:Name="StateContent" FontSize="15" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" MaxWidth="200">
                <Label.ContentTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                       TextWrapping="WrapWithOverflow"
                       TextAlignment="Center"
                       Foreground="#333333"/>
                    </DataTemplate>
                </Label.ContentTemplate>
            </Label>
            <local:DoubleLabel Grid.Row="4" Grid.Column="5" Margin="5, 3" x:Name="VersionBox" TitleBackground="#EEE"/>
            <local:DoubleLabel Grid.Row="5" Grid.Column="5" Margin="5, 3" x:Name="CompileBox" TitleBackground="#EEE"/>
            <local:DoubleLabel Grid.Row="6" Grid.Column="5" Margin="5, 3" x:Name="StateBox" TitleBackground="#EEE"/>
            <local:DoubleLabel TitleBroderBrush="Black" ContentBroderBrush="Black" ContentSize="15" TitleSize="15" Grid.RowSpan="1" x:Name="ChannelView" Grid.Row="1" Grid.Column="5" TitleBackground="#FFF" Margin="5, 3" Title="Channel"/>
            <CheckBox x:Name="ApplyNewVersion" Grid.Row="1" Grid.Column="6" Margin="5,3,52,3" Content="신버전 프로토콜" FontSize="15" Visibility="Visible" VerticalContentAlignment="Center" IsChecked="True"/>
            <CheckBox x:Name="DummyCheck" Grid.Row="1" Grid.Column="6" Margin="139,3,2,3" Content="더미" FontSize="15" Visibility="Visible" VerticalContentAlignment="Center" IsChecked="true" Grid.ColumnSpan="2"/>
            <local:ModeTimeLabel Grid.Row="2" Grid.RowSpan="2" Grid.Column="6" Margin="5, 3" x:Name="ModeTimeView"/>
            <Button x:Name="ParameterButton" Grid.Row="4" Grid.Column="6" Margin="5, 3" Padding="0" Content="파라미터" FontSize="13"/>
            <Button x:Name="StartButton" Background="Transparent" FontSize="12" Padding="0" BorderBrush="Blue" BorderThickness="1" Grid.Row="5" Grid.Column="6" Grid.RowSpan="1" Content="Start" Foreground="Blue" Margin="5, 5"/>
            <Button x:Name="StopButton" Background="Transparent" FontSize="12" Padding="0" BorderBrush="Red" BorderThickness="1" Grid.Row="6" Grid.Column="6" Grid.RowSpan="1" Content="Stop" Foreground="Red" Margin="5, 5"/>
        </Grid>
    </Border>
</UserControl>
