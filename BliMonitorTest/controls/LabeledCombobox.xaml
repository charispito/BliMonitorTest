<UserControl x:Class="BliMonitorTest.controls.LabeledCombobox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label x:Name="label" Grid.Column="0" Foreground="{DynamicResource TextMute}" FontWeight="SemiBold" FontSize="12.5" VerticalContentAlignment="Center" Padding="8,0"/>
        <ComboBox x:Name="box" Grid.Column="2" Style="{StaticResource PrettyComboBoxStyle}"/>
    </Grid>
</UserControl>
