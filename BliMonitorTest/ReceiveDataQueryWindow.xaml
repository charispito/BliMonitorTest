<Window x:Class="BliMonitorTest.ReceiveDataQueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="수신 데이터 조회 (receive_data)"
        Width="1824" Height="900"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Window.Resources>
        <!-- 가운데 정렬 텍스트 -->
        <Style x:Key="CenterCellTextBlock" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- 텍스트 + 툴팁 -->
        <DataTemplate x:Key="CenterCellTemplate">
            <TextBlock Style="{StaticResource CenterCellTextBlock}"
               Text="{Binding}"
               ToolTip="{Binding}"/>
        </DataTemplate>

        <!-- 헤더 중앙 정렬 -->
        <Style x:Key="CenterHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="4,0,4,0"/>
        </Style>

        <!-- 기본 DataGrid 보기 최적화 -->
        <Style x:Key="CenterGridStyle" TargetType="DataGrid" BasedOn="{StaticResource PrettyDataGridStyle}">
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource CenterHeaderStyle}"/>
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>

            <!-- 셀: 중앙정렬 + 선택 하이라이트 -->
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 검색조건 카드 -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1500"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="검색 조건" Style="{StaticResource SectionTitleStyleTextBlock}" Margin="0,0,0,10"/>

                        <!-- 기간 -->
                        <WrapPanel HorizontalAlignment="Left" Width="1500" Margin="0,0,0,6">
                            <Grid Margin="0,0,12,0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="기간 :" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <DatePicker Grid.Column="2" x:Name="dpFrom" Width="140"/>
                                <ComboBox Grid.Column="4" x:Name="cbFromHour" Width="60" Style="{StaticResource PrettyComboBoxStyle}"/>
                                <ComboBox Grid.Column="6" x:Name="cbFromMinute" Width="60" Style="{StaticResource PrettyComboBoxStyle}"/>
                                <TextBlock Grid.Column="8" Text="~" VerticalAlignment="Center"/>
                                <DatePicker Grid.Column="10" x:Name="dpTo" Width="140"/>
                                <ComboBox Grid.Column="12" x:Name="cbToHour" Width="60" Style="{StaticResource PrettyComboBoxStyle}"/>
                                <ComboBox Grid.Column="14" x:Name="cbToMinute" Width="60" Style="{StaticResource PrettyComboBoxStyle}"/>
                            </Grid>
                        </WrapPanel>

                        <!-- 행1: 모델/SW/소스/채널 -->
                        <WrapPanel HorizontalAlignment="Left" Width="1500" Margin="0,0,0,6">
                            <TextBlock Text="모델 :" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="cbModelCode" Width="120" Margin="8,0,16,0" Style="{StaticResource PrettyComboBoxStyle}" ToolTip="모델 번호(제품구분)">
                                <ComboBoxItem Content="전체" Tag="{x:Null}" IsSelected="True"/>
                                <!-- 모델코드표에 맞춰 추가 -->
                                <ComboBoxItem Content="0x00" Tag="0"/>
                                <ComboBoxItem Content="0x01" Tag="1"/>
                                <ComboBoxItem Content="0x02" Tag="2"/>
                            </ComboBox>

                            <TextBlock Text="SW 버전 :" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="cbSwVer" Width="120" Margin="8,0,16,0" Style="{StaticResource PrettyComboBoxStyle}">
                                <ComboBoxItem Content="전체" Tag="{x:Null}" IsSelected="True"/>
                                <ComboBoxItem Content="0x00" Tag="0"/>
                                <ComboBoxItem Content="0x01" Tag="1"/>
                                <ComboBoxItem Content="0x02" Tag="2"/>
                            </ComboBox>

                            <TextBlock Text="채널 :" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="cbSourceType" Width="120" Margin="8,0,16,0" Style="{StaticResource PrettyComboBoxStyle}">
                                <ComboBoxItem Content="전체" Tag="0" IsSelected="True"/>
                                <ComboBoxItem Content="단일" Tag="1"/>
                                <ComboBoxItem Content="다채널" Tag="2"/>
                            </ComboBox>

                            <TextBlock Text="채널번호 :" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="tbChannelNo" Width="90" Margin="8,0,8,0" KeyDown="SearchBox_KeyDown" ToolTip="0=전체, 1~N"/>
                        </WrapPanel>

                        <!-- 행2: 온도/전압 범위 -->
                        <WrapPanel HorizontalAlignment="Left" Width="1500" Margin="0,0,0,6">
                            <TextBlock Text="히터온도 ≥" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="tbHeaterMin" Width="90" Margin="8,0,8,0" KeyDown="SearchBox_KeyDown"/>
                            <TextBlock Text="≤" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="tbHeaterMax" Width="90" Margin="8,0,16,0" KeyDown="SearchBox_KeyDown"/>

                            <TextBlock Text="냉수온도 ≥" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="tbColdMin" Width="90" Margin="8,0,8,0" KeyDown="SearchBox_KeyDown"/>
                            <TextBlock Text="≤" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="tbColdMax" Width="90" Margin="8,0,16,0" KeyDown="SearchBox_KeyDown"/>

                            <TextBlock Text="콤프레셔 :" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="cbCompOn" Width="100" Margin="8,0,16,0" Style="{StaticResource PrettyComboBoxStyle}">
                                <ComboBoxItem Content="전체" Tag="{x:Null}" IsSelected="True"/>
                                <ComboBoxItem Content="ON" Tag="1"/>
                                <ComboBoxItem Content="OFF" Tag="0"/>
                            </ComboBox>
                        </WrapPanel>

                        <!-- 행3: 센서/솔/펌프 ON/OFF -->
                        <WrapPanel HorizontalAlignment="Left" Width="1500" Margin="0,0,0,6">
                            <!-- 공통 3상태 콤보(전체/ON/OFF)를 재사용 -->
                            <TextBlock Text="수위센서 :" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="cbLowWaterSensor" Width="100" Margin="8,0,16,0" Style="{StaticResource PrettyComboBoxStyle}">
                                <ComboBoxItem Content="전체" Tag="{x:Null}" IsSelected="True"/>
                                <ComboBoxItem Content="ON" Tag="1"/>
                                <ComboBoxItem Content="OFF" Tag="0"/>
                            </ComboBox>

                            <TextBlock Text="플로어 센서 :" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="cbFloorSensor" Width="110" Margin="8,0,16,0" Style="{StaticResource PrettyComboBoxStyle}">
                                <ComboBoxItem Content="전체" Tag="{x:Null}" IsSelected="True"/>
                                <ComboBoxItem Content="ON" Tag="1"/>
                                <ComboBoxItem Content="OFF" Tag="0"/>
                            </ComboBox>

                            <TextBlock Text="UV LED :" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="cbUvLed" Width="100" Margin="8,0,16,0" Style="{StaticResource PrettyComboBoxStyle}">
                                <ComboBoxItem Content="전체" Tag="{x:Null}" IsSelected="True"/>
                                <ComboBoxItem Content="ON" Tag="1"/>
                                <ComboBoxItem Content="OFF" Tag="0"/>
                            </ComboBox>

                            <TextBlock Text="3방 SOL 1 :" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="cbTriSol1" Width="100" Margin="8,0,16,0" Style="{StaticResource PrettyComboBoxStyle}">
                                <ComboBoxItem Content="전체" Tag="{x:Null}" IsSelected="True"/>
                                <ComboBoxItem Content="ON" Tag="1"/>
                                <ComboBoxItem Content="OFF" Tag="0"/>
                            </ComboBox>

                            <TextBlock Text="3방 SOL 2 :" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="cbTriSol2" Width="100" Margin="8,0,16,0" Style="{StaticResource PrettyComboBoxStyle}">
                                <ComboBoxItem Content="전체" Tag="{x:Null}" IsSelected="True"/>
                                <ComboBoxItem Content="ON" Tag="1"/>
                                <ComboBoxItem Content="OFF" Tag="0"/>
                            </ComboBox>

                            <TextBlock Text="3방 SOL 3 :" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="cbTriSol3" Width="100" Margin="8,0,16,0" Style="{StaticResource PrettyComboBoxStyle}">
                                <ComboBoxItem Content="전체" Tag="{x:Null}" IsSelected="True"/>
                                <ComboBoxItem Content="ON" Tag="1"/>
                                <ComboBoxItem Content="OFF" Tag="0"/>
                            </ComboBox>
                        </WrapPanel>

                        <!-- 행4: 나머지 ON/OFF + Needle -->
                        <WrapPanel HorizontalAlignment="Left" Width="1500">
                            <TextBlock Text="Air Vent :" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="cbAirVentSol" Width="100" Margin="8,0,16,0" Style="{StaticResource PrettyComboBoxStyle}">
                                <ComboBoxItem Content="전체" Tag="{x:Null}" IsSelected="True"/>
                                <ComboBoxItem Content="ON" Tag="1"/>
                                <ComboBoxItem Content="OFF" Tag="0"/>
                            </ComboBox>

                            <TextBlock Text="C/V :" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="cbCvSol" Width="100" Margin="8,0,16,0" Style="{StaticResource PrettyComboBoxStyle}">
                                <ComboBoxItem Content="전체" Tag="{x:Null}" IsSelected="True"/>
                                <ComboBoxItem Content="ON" Tag="1"/>
                                <ComboBoxItem Content="OFF" Tag="0"/>
                            </ComboBox>

                            <TextBlock Text="PUMP :" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="cbPumpOn" Width="100" Margin="8,0,16,0" Style="{StaticResource PrettyComboBoxStyle}">
                                <ComboBoxItem Content="전체" Tag="{x:Null}" IsSelected="True"/>
                                <ComboBoxItem Content="ON" Tag="1"/>
                                <ComboBoxItem Content="OFF" Tag="0"/>
                            </ComboBox>

                            <TextBlock Text="Cold Sol :" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="cbColdSol" Width="100" Margin="8,0,16,0" Style="{StaticResource PrettyComboBoxStyle}">
                                <ComboBoxItem Content="전체" Tag="{x:Null}" IsSelected="True"/>
                                <ComboBoxItem Content="ON" Tag="1"/>
                                <ComboBoxItem Content="OFF" Tag="0"/>
                            </ComboBox>

                            <TextBlock Text="Normal Sol :" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="cbNormalSol" Width="110" Margin="8,0,16,0" Style="{StaticResource PrettyComboBoxStyle}">
                                <ComboBoxItem Content="전체" Tag="{x:Null}" IsSelected="True"/>
                                <ComboBoxItem Content="ON" Tag="1"/>
                                <ComboBoxItem Content="OFF" Tag="0"/>
                            </ComboBox>

                            <TextBlock Text="Hot Sol1 :" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="cbHotSol1" Width="100" Margin="8,0,16,0" Style="{StaticResource PrettyComboBoxStyle}">
                                <ComboBoxItem Content="전체" Tag="{x:Null}" IsSelected="True"/>
                                <ComboBoxItem Content="ON" Tag="1"/>
                                <ComboBoxItem Content="OFF" Tag="0"/>
                            </ComboBox>

                            <TextBlock Text="Needle 위치 :" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="cbNeedleState" Width="130" Margin="8,0,0,0" Style="{StaticResource PrettyComboBoxStyle}">
                                <ComboBoxItem Content="전체" Tag="{x:Null}" IsSelected="True"/>
                                <ComboBoxItem Content="상승 상태(0)" Tag="0"/>
                                <ComboBoxItem Content="동작중(1)" Tag="1"/>
                                <ComboBoxItem Content="하강 상태(2)" Tag="2"/>
                            </ComboBox>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Content="조회" Width="90" Style="{StaticResource SoftButtonStyle}" Click="Search_Click"/>
                        <Button x:Name="btnExcel" Content="엑셀" Width="80" Margin="5,0,0,0" Style="{StaticResource SoftButtonStyle}" Click="ExcelDownload_Click"/>
                        <Button x:Name="btnCancelBusy" Content="취소" Width="80" Margin="5,0,0,0" Style="{StaticResource SoftButtonStyle}" Click="CancelBusy_Click" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 결과/페이징은 기존 유지 -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <TextBlock Text="조회 결과" FontSize="15" FontWeight="Bold" DockPanel.Dock="Left"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <TextBlock Text="데이터 건  :" Style="{StaticResource FieldLabelStyle}" Margin="50,5,0,0" FontWeight="Bold"/>
                            <ComboBox x:Name="cbPageSize" Width="110" Style="{StaticResource PrettyComboBoxStyle}" SelectionChanged="PageSize_Changed" Margin="10,0,0,0">
                                <ComboBoxItem Content="10"/>
                                <ComboBoxItem Content="30"/>
                                <ComboBoxItem Content="50" IsSelected="True"/>
                                <ComboBoxItem Content="100"/>
                                <ComboBoxItem Content="200"/>
                                <ComboBoxItem Content="500"/>
                            </ComboBox>
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="2" BorderBrush="{StaticResource SoftBorderBrush}" BorderThickness="1" CornerRadius="10" Background="White" SnapsToDevicePixels="True">
                        <DataGrid x:Name="grid"
                              Style="{StaticResource CenterGridStyle}"
                              AutoGenerateColumns="True"
                              AutoGeneratedColumns="Grid_AutoGeneratedColumns"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="txtPageInfo" Grid.Column="0" Text="총 0건 / 0 / 0 페이지" Foreground="{StaticResource TextMute}" FontSize="13" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="⏮ 처음" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="First_Click"/>
                        <Button Content="◀ 이전" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="Prev_Click"/>
                        <Button Content="다음 ▶" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="Next_Click"/>
                        <Button Content="끝 ⏭" Style="{StaticResource SecondaryButtonStyle}" Click="Last_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Busy Overlay -->
        <Grid x:Name="BusyOverlay" Visibility="Collapsed" Background="#66000000" Panel.ZIndex="9999">
            <Border Width="360" Padding="18" Background="White" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="조회 중입니다..." FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="데이터가 많으면 시간이 걸릴 수 있어요." Foreground="{StaticResource TextMute}" Margin="0,0,0,12"/>
                    <ProgressBar Height="12" IsIndeterminate="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
