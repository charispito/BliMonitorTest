<Window x:Class="BliMonitorTest.ReceiveDataQueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="수신 데이터 조회 (receive_data)"
        Width="1824" Height="850"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <!-- 바깥 배경 -->
    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="0,0,0,0">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 검색조건 카드 -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1500"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="검색 조건" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                        <WrapPanel HorizontalAlignment="Left" Width="1500">
                            <Grid Margin="0,0,12,0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="기간 :" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top" Grid.ColumnSpan="2" Margin="0,6,8,0"/>
                                <DatePicker Grid.Column="2" x:Name="dpFrom" Width="140" />

                                <TextBlock Grid.Column="4" Text="~" VerticalAlignment="Center" />
                                <DatePicker Grid.Column="6" x:Name="dpTo" Width="140" />
                            </Grid>

                            <TextBlock Text="Mode :" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="tbMode" Width="90" Margin="8,0,8,0" KeyDown="SearchBox_KeyDown"/>

                            <TextBlock Text="Heater : ≥" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="tbHeaterMin" Width="90" Margin="8,0,8,0" KeyDown="SearchBox_KeyDown"/>
                            <TextBlock Text="≤" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="tbHeaterMax" Width="90" Margin="8,0,8,0" KeyDown="SearchBox_KeyDown"/>

                            <TextBlock Text="Air : ≥" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="tbAirMin" Width="90" Margin="8,0,8,0" KeyDown="SearchBox_KeyDown"/>
                            <TextBlock Text="≤" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="tbAirMax" Width="90" Margin="8,0,8,0" KeyDown="SearchBox_KeyDown"/>

                            <TextBlock Text="Motor:" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="tbMotor" Width="90" Margin="8,0,8,0" KeyDown="SearchBox_KeyDown"/>

                            <TextBlock Text="Fan:" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="tbFanSpeed" Width="90" Margin="8,0,8,0" KeyDown="SearchBox_KeyDown"/>

                            <TextBlock Text="Source:" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="cbSourceType" Width="120" Margin="8,0,8,0" Style="{StaticResource PrettyComboBoxStyle}">
                                <ComboBoxItem Content="전체" Tag="0" IsSelected="True"/>
                                <ComboBoxItem Content="단일" Tag="1"/>
                                <ComboBoxItem Content="다채널" Tag="2"/>
                            </ComboBox>
                            <TextBlock Text="Channel:" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="tbChannelNo" Width="90" Margin="8,0,8,0" KeyDown="SearchBox_KeyDown" ToolTip="0=전체, 1~N"/>

                            <TextBlock Text="MotorCurrent ≥" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="tbMotorCurrentMin" Width="90" Margin="8,0,8,0" KeyDown="SearchBox_KeyDown"/>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Content="조회" Width="90" Style="{StaticResource PrimaryButtonStyle}" Click="Search_Click"/>
                        <Button x:Name="btnExcel" Content="엑셀" Width="80" Margin="5,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="ExcelDownload_Click"/>
                        <Button x:Name="btnCancelBusy" Content="취소" Width="80" Margin="5,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="CancelBusy_Click" Background="#0EA5E9" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 결과 그리드 카드 -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <TextBlock Text="조회 결과" FontSize="15" FontWeight="Bold" DockPanel.Dock="Left"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <TextBlock Text="데이터 건  :" Style="{StaticResource FieldLabelStyle}" Margin="50,5,0,0" FontWeight="Bold"/>
                            <ComboBox x:Name="cbPageSize" Width="110" Style="{StaticResource PrettyComboBoxStyle}" SelectionChanged="PageSize_Changed" Margin="10,0,0,0">
                                <ComboBoxItem Content="10"/>
                                <ComboBoxItem Content="30"/>
                                <ComboBoxItem Content="50" IsSelected="True"/>
                                <ComboBoxItem Content="100"/>
                                <ComboBoxItem Content="200"/>
                                <ComboBoxItem Content="500"/>
                            </ComboBox>
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="2" BorderBrush="{StaticResource SoftBorderBrush}" BorderThickness="1" CornerRadius="10" Background="White" SnapsToDevicePixels="True">
                        <DataGrid x:Name="grid" Style="{StaticResource PrettyDataGridStyle}" AutoGenerateColumns="True" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 하단 페이징 카드 -->
            <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="txtPageInfo" Grid.Column="0" Text="총 0건 / 0 / 0 페이지" Foreground="{StaticResource TextMute}" FontSize="13" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="⏮ 처음" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="First_Click"/>
                        <Button Content="◀ 이전" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="Prev_Click"/>
                        <Button Content="다음 ▶" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="Next_Click"/>
                        <Button Content="끝 ⏭" Style="{StaticResource SecondaryButtonStyle}" Click="Last_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
        <!-- ✅ Busy Overlay: 조회 중 입력 차단 + 진행 표시 (맨 마지막에 둬야 위에 덮임) -->
        <Grid x:Name="BusyOverlay" Visibility="Collapsed" Background="#66000000" Panel.ZIndex="9999">
            <Border Width="360" Padding="18" Background="White" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="조회 중입니다..." FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="데이터가 많으면 시간이 걸릴 수 있어요." Foreground="{StaticResource TextMute}" Margin="0,0,0,12"/>
                    <ProgressBar Height="12" IsIndeterminate="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
