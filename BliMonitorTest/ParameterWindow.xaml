                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="FontSize" Value="13"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="False" CanUserReorder="False" Width="*" CanUserSort="False" Header="월" Binding="{Binding Month}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="FontSize" Value="13"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="False" CanUserReorder="False" Width="*" CanUserSort="False" Header="일" Binding="{Binding Day}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="FontSize" Value="13"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="False" CanUserReorder="False" Width="*" CanUserSort="False" Header="ver." Binding="{Binding Ver}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="FontSize" Value="13"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
