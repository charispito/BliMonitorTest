<Window x:Class="BliMonitorTest.ParameterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BliMonitorTest"
        mc:Ignorable="d"
        Title="BLI 모니터링 프로그램 - 파라미터 설정"
        Height="1235"
        Width="1735"
        SizeToContent="Manual"
        Background="Transparent">

    <Window.Resources>
        <!-- DataGrid 공통 스타일 (ParameterWindow에서 사용하는 GridStyle 키 제공) -->
        <Style x:Key="GridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FBFDFF"/>

            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource SoftBorderBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource SoftBorderBrush}"/>

            <Setter Property="BorderBrush" Value="{StaticResource SoftBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="HeadersVisibility" Value="None"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="SelectionMode" Value="Single"/>

            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderBrush" Value="{StaticResource SoftBorderBrush}"/>
                        <Setter Property="BorderThickness" Value="0.5"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#374151"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>

                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EAF4FF"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#374151"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>

            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="MinHeight" Value="28"/>
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#374151"/>
                        <Setter Property="BorderThickness" Value="0"/>

                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EAF4FF"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#374151"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CenterErrorGridStyle" TargetType="DataGrid" BasedOn="{StaticResource GridStyle}">
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderBrush" Value="{StaticResource SoftBorderBrush}"/>
                        <Setter Property="BorderThickness" Value="0.5"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ErrorGridNameCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="{StaticResource SoftBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EAF4FF"/>
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="False">
                    <Setter Property="Background" Value="#F3F4F6"/>
                    <Setter Property="Foreground" Value="#374151"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ErrorGridValueCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="{StaticResource SoftBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EAF4FF"/>
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="False">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="#374151"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenterColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="{StaticResource SoftBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>

    <!-- ✅ 바깥 배경 -->
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1424*"/>
            <ColumnDefinition Width="270*"/>
            <ColumnDefinition Width="81*"/>
        </Grid.ColumnDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Grid.ColumnSpan="3">

            <!-- 바깥 여백 -->
            <Grid Margin="12" ShowGridLines="False">

                <!-- ✅ 전체 프레임 카드 -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                    <Grid ShowGridLines="False">

                        <!-- ===== 원본 Grid 구조 유지 ===== -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1140"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="20"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="430"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="620"/>
                            <RowDefinition Height="20"/>
                        </Grid.RowDefinitions>

                        <!-- =========================
                             좌측: 검사 항목 설정 섹션(카드)
                        ========================== -->
                        <Border Grid.Row="1"
                                Grid.Column="1"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource CardBorderStyle}"
                                Margin="5,0,10,0"
                                Height="430"
                                VerticalAlignment="Top">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Content="검사 항목 설정" Style="{StaticResource SectionTitleStyleLabel}"/>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="OpenErrorDataQueryButton" Content="에러이력 조회" Width="140" Height="28" Margin="0,0,10,0" Style="{StaticResource OutlineRedButtonStyle}"/>
                                    <Button x:Name="ReadErrorButton" Content="READ" Width="140" Height="28" Margin="0,0,10,0" Style="{StaticResource OutlineBlueButtonStyle}"/>
                                    <Button x:Name="ResetErrorButton" Content="RESET" Width="140" Height="28" Margin="0,0,10,0" Style="{StaticResource OutlineRedButtonStyle}"/>
                                </StackPanel>

                                <!-- Error 라벨 줄 -->
                                <!-- 라벨줄: 8열 균등, 좌우 여백 약간 -->
                                <Grid Grid.Row="1" HorizontalAlignment="Stretch" Margin="0,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Label FontSize="14" Content="Error1" FontWeight="Black" HorizontalContentAlignment="Center"/>
                                    <Label FontSize="14" Grid.Column="1" Content="Error2" FontWeight="Black" HorizontalContentAlignment="Center"/>
                                    <Label FontSize="14" Grid.Column="2" Content="Error3" FontWeight="Black" HorizontalContentAlignment="Center"/>
                                    <Label FontSize="14" Grid.Column="3" Content="Error4" FontWeight="Black" HorizontalContentAlignment="Center"/>
                                    <Label FontSize="14" Grid.Column="4" Content="Error5" FontWeight="Black" HorizontalContentAlignment="Center"/>
                                    <Label FontSize="14" Grid.Column="5" Content="Error6" FontWeight="Black" HorizontalContentAlignment="Center"/>
                                    <Label FontSize="14" Grid.Column="6" Content="Error7" FontWeight="Black" HorizontalContentAlignment="Center"/>
                                    <Label FontSize="14" Grid.Column="7" Content="Error8" FontWeight="Black" HorizontalContentAlignment="Center"/>
                                </Grid>

                                <!-- ErrorGrid: 폭 고정 대신 Stretch, 마지막에 여백 -->
                                <DataGrid Grid.Row="2"
                                          x:Name="ErrorGrid"
                                          Style="{StaticResource GridStyle}"
                                          Margin="0,6,8,0"
                                          BorderThickness="1"
                                          HeadersVisibility="None"
                                          CanUserAddRows="False"
                                          AutoGenerateColumns="False"
                                          VerticalAlignment="Stretch"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.CanContentScroll="True">

                                    <DataGrid.Columns>
                                        <!-- Error1 -->
                                        <DataGridTextColumn IsReadOnly="True" Width="1.25*" Binding="{Binding Name}" CellStyle="{StaticResource ErrorGridNameCellStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Foreground" Value="#4B5563"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="False" Width="*" Binding="{Binding Value}" CellStyle="{StaticResource ErrorGridValueCellStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Foreground" Value="#4B5563"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Error2 -->
                                        <DataGridTextColumn IsReadOnly="True" Width="1.25*" Binding="{Binding Name}" CellStyle="{StaticResource ErrorGridNameCellStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Foreground" Value="#4B5563"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="False" Width="*" Binding="{Binding Value2}" CellStyle="{StaticResource ErrorGridValueCellStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Foreground" Value="#4B5563"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Error3 -->
                                        <DataGridTextColumn IsReadOnly="True" Width="1.25*" Binding="{Binding Name}" CellStyle="{StaticResource ErrorGridNameCellStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Foreground" Value="#4B5563"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="False" Width="*" Binding="{Binding Value3}" CellStyle="{StaticResource ErrorGridValueCellStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Foreground" Value="#4B5563"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Error4 -->
                                        <DataGridTextColumn IsReadOnly="True" Width="1.25*" Binding="{Binding Name}" CellStyle="{StaticResource ErrorGridNameCellStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Foreground" Value="#4B5563"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="False" Width="*" Binding="{Binding Value4}" CellStyle="{StaticResource ErrorGridValueCellStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Foreground" Value="#4B5563"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Error5 -->
                                        <DataGridTextColumn IsReadOnly="True" Width="1.25*" Binding="{Binding Name}" CellStyle="{StaticResource ErrorGridNameCellStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Foreground" Value="#4B5563"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="False" Width="*" Binding="{Binding Value5}" CellStyle="{StaticResource ErrorGridValueCellStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Foreground" Value="#4B5563"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Error6 -->
                                        <DataGridTextColumn IsReadOnly="True" Width="1.25*" Binding="{Binding Name}" CellStyle="{StaticResource ErrorGridNameCellStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Foreground" Value="#4B5563"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="False" Width="*" Binding="{Binding Value6}" CellStyle="{StaticResource ErrorGridValueCellStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Foreground" Value="#4B5563"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Error7 -->
                                        <DataGridTextColumn IsReadOnly="True" Width="1.25*" Binding="{Binding Name}" CellStyle="{StaticResource ErrorGridNameCellStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Foreground" Value="#4B5563"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="False" Width="*" Binding="{Binding Value7}" CellStyle="{StaticResource ErrorGridValueCellStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Foreground" Value="#4B5563"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Error8 -->
                                        <DataGridTextColumn IsReadOnly="True" Width="1.25*" Binding="{Binding Name}" CellStyle="{StaticResource ErrorGridNameCellStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Foreground" Value="#4B5563"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="False" Width="*" Binding="{Binding Value8}" CellStyle="{StaticResource ErrorGridValueCellStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Foreground" Value="#4B5563"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- =========================
                             우측: 파일 패널(카드)
                        ========================== -->
                        <Border Grid.Row="1"
                                Grid.Column="5"
                                Grid.RowSpan="4"
                                Style="{StaticResource CardBorderStyle}"
                                Margin="0,0,0,5"
                                VerticalAlignment="Stretch"
                                Height="1100">
                            <Grid>
                                <Grid.Resources>
                                    <!-- 행 공통 마진 -->
                                    <Style x:Key="FormRowGrid" TargetType="Grid">
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                    </Style>
                                    <!-- 라벨 스타일 -->
                                    <Style x:Key="FormLabel" TargetType="Label">
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#6B7280"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,8,0"/>
                                        <Setter Property="Height" Value="15"/>
                                    </Style>
                                    <!-- 입력칸 스타일: SoftTextBoxStyle 기반 -->
                                    <Style x:Key="FormTextBox" TargetType="TextBox" BasedOn="{StaticResource SoftTextBoxStyle}">
                                        <Setter Property="Height" Value="30"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    </Style>
                                </Grid.Resources>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <!-- 리스트(가변, 내부 스크롤) -->
                                    <RowDefinition Height="80"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 파일 (에러) 제목 -->
                                <Label Grid.Row="0" Content="파일 (에러)" Style="{StaticResource SectionTitleStyleLabel}"/>

                                <!-- 파일이름(에러): 1행 2열 -->
                                <Grid Grid.Row="1" Style="{StaticResource FormRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="파일이름" Style="{StaticResource FormLabel}"/>
                                    <TextBox Grid.Column="1" x:Name="ErrorFileName" Style="{StaticResource FormTextBox}"/>
                                </Grid>

                                <!-- 필터(에러): 1행 2열 -->
                                <Grid Grid.Row="2" Style="{StaticResource FormRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="필터" Style="{StaticResource FormLabel}"/>
                                    <TextBox Grid.Column="1" x:Name="ErrorSearchBox" Style="{StaticResource FormTextBox}" TextChanged="ErrorSearchBox_TextChanged"/>
                                </Grid>

                                <!-- 리스트(에러): 고정 높이 + 내부 스크롤 -->
                                <ListBox Grid.Row="3"
                                         x:Name="ErrorFileList"
                                         Height="255"
                                         Style="{StaticResource SoftListBoxStyle}"
                                         SelectionMode="Extended"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <EventSetter Event="MouseDoubleClick" Handler="ErrorListDoubleClick"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>

                                <!-- 버튼(에러) -->
                                <Grid Grid.Row="4" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <Button Content="저장" x:Name="ErrorSaveButton" Style="{StaticResource SoftButtonStyle}"/>
                                    <Button Grid.Column="2" x:Name="ErrorDeleteButton" Content="삭제" Style="{StaticResource SoftButtonStyle}"/>
                                    <Button Grid.Column="4" x:Name="ErrorRefreshButton" Content="갱신" Style="{StaticResource SoftButtonStyle}"/>
                                    <Button Grid.Column="6" x:Name="ErrorExcelButton" Content="엑셀" Style="{StaticResource SoftButtonStyle}"/>
                                </Grid>

                                <!-- 구분선 -->
                                <Border Grid.Row="5" Height="1" Background="#E5E7EB" Margin="0,30,0,5"/>

                                <!-- 파일 (수신 파라미터) 제목 -->
                                <Label Grid.Row="6" Content="파일 (수신 파라미터)" Style="{StaticResource SectionTitleStyleLabel}"/>

                                <!-- 파일이름(파라미터): 1행 2열 -->
                                <Grid Grid.Row="7" Style="{StaticResource FormRowGrid}" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="파일이름" Style="{StaticResource FormLabel}"/>
                                    <TextBox Grid.Column="1" x:Name="FileName" Style="{StaticResource FormTextBox}"/>
                                </Grid>

                                <!-- 필터(파라미터): 1행 2열 -->
                                <Grid Grid.Row="8" Style="{StaticResource FormRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="필터" Style="{StaticResource FormLabel}"/>
                                    <TextBox Grid.Column="1" x:Name="FileSearchBox" Style="{StaticResource FormTextBox}" TextChanged="FileSearchBox_TextChanged"/>
                                </Grid>

                                <!-- 리스트(파라미터): 고정 높이 + 내부 스크롤 -->
                                <ListBox Grid.Row="9"
                                         x:Name="FileList"
                                         Height="420"
                                         Style="{StaticResource SoftListBoxStyle}"
                                         SelectionMode="Extended"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <EventSetter Event="MouseDoubleClick" Handler="ListDoubleClick"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>

                                <!-- 버튼(파라미터) -->
                                <Grid Grid.Row="10" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="저장" x:Name="SaveButton" Style="{StaticResource SoftButtonStyle}"/>
                                    <Button Grid.Column="2" x:Name="DeleteButton" Content="삭제" Style="{StaticResource SoftButtonStyle}"/>
                                    <Button Grid.Column="4" x:Name="RefreshButton" Content="갱신" Style="{StaticResource SoftButtonStyle}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- =========================
                        하단: Micom Parameter / Status 섹션
                        ========================= -->
                        <Label Grid.Row="3"
                               Grid.Column="1"
                               Grid.ColumnSpan="3"
                               Content="PARAMETER 정보"
                               Style="{StaticResource SectionTitleStyleLabel}"
                               Margin="5,0,0,10"/>

                        <Border Grid.Row="4"
                                Grid.Column="1"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource CardBorderStyle}"
                                Margin="0,0,10,0"
                                Padding="12"
                                Height="620"
                                VerticalAlignment="Top">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 좌측 타이틀 -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="수신 PARAMETER" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="  (MCU READ 결과)" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 가운데 타이틀 -->
                                <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="COPY" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- 우측 타이틀 -->
                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="설정 PARAMETER" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <TextBlock Text="  (설정값 셋팅)" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 좌측 수신 그리드 -->
                                <DataGrid x:Name="ReceivedParamGrid"
          Grid.Row="2"
          Grid.Column="0"
          Style="{StaticResource GridStyle}"
          AutoGenerateColumns="False"
          VerticalAlignment="Top"
          HeadersVisibility="Column"
          ColumnHeaderStyle="{StaticResource CenterColumnHeaderStyle}"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          CanUserResizeRows="False"
          IsReadOnly="True"
          Height="502"
          Margin="0,0,8,0"
          SelectionChanged="ReceivedParamGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="항목1" Width="1.7*" Binding="{Binding Name1}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="#F3F4F6"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="값1" Width="1.1*" Binding="{Binding Value1}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="항목2" Width="1.7*" Binding="{Binding Name2}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="#F3F4F6"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="값2" Width="1.1*" Binding="{Binding Value2}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- 가운데 COPY 버튼 -->
                                <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Button x:Name="CopyToEditButton" Content=" ▶" Width="52" Height="42" FontSize="20" FontWeight="Bold" Style="{StaticResource SoftButtonStyle}"/>
                                    <TextBlock Text="좌측 → 우측" Margin="0,10,0,0" FontSize="12" Foreground="#6B7280" TextAlignment="Center"/>
                                </StackPanel>

                                <!-- 우측 편집 그리드 -->
                                <DataGrid x:Name="EditableParamGrid"
          Grid.Row="2"
          Grid.Column="2"
          Style="{StaticResource GridStyle}"
          AutoGenerateColumns="False"
          VerticalAlignment="Top"
          HeadersVisibility="Column"
          ColumnHeaderStyle="{StaticResource CenterColumnHeaderStyle}"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          CanUserResizeRows="False"
          IsReadOnly="False"
          Height="502"
          Margin="8,0,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="항목1" Width="1.7*" Binding="{Binding Name1}" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="#F3F4F6"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="설정값1" Width="1.1*" Binding="{Binding Value1}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="항목2" Width="1.7*" Binding="{Binding Name2}" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="#F3F4F6"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="설정값2" Width="1.1*" Binding="{Binding Value2}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- 하단 버튼 -->
                                <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="ReadParamButton" Content="PARAMETER READ" Width="150" Height="34" Margin="0,0,8,0" Style="{StaticResource OutlineBlueButtonStyle}"/>
                                    <Button x:Name="WriteParamButton" Content="PARAMETER WRITE" Width="160" Height="34" Style="{StaticResource OutlineRedButtonStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- =========================
                             하단(숨김 영역): 그대로 유지
                        ========================== -->
                        <Grid Grid.Row="4"
                              Grid.Column="1"
                              ShowGridLines="False"
                              Width="630"
                              HorizontalAlignment="Left"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Label Visibility="Collapsed" Content="Micom 정보" Grid.Column="1" FontSize="15" FontWeight="Black"/>
                            <Label Visibility="Collapsed" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="1" Grid.RowSpan="2" Content="컴파일 정보" Grid.Column="1" Background="#CCC" BorderBrush="Black" BorderThickness="0.5"/>

                            <DataGrid Visibility="Collapsed"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource GridStyle}"
                                      HeadersVisibility="Column"
                                      Background="Transparent"
                                      Grid.Row="1"
                                      Grid.Column="2"
                                      Grid.ColumnSpan="2"
                                      BorderThickness="2,2,0,0"
                                      Height="Auto"
                                      CanUserAddRows="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      AutoGenerateColumns="False"
                                      x:Name="ComplieGrid">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="{x:Type DataGridColumnHeader}">
                                        <Setter Property="Background" Value="#CCC"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="BorderThickness" Value="0.5,0.5"/>
                                        <Setter Property="BorderBrush" Value="Black"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Padding" Value="5,1"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.Columns>
                                    <DataGridTextColumn IsReadOnly="True" CanUserReorder="False" Width="*" CanUserSort="False" Header="년" Binding="{Binding Year}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="FontSize" Value="13"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="False" CanUserReorder="False" Width="*" CanUserSort="False" Header="월" Binding="{Binding Month}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="FontSize" Value="13"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="False" CanUserReorder="False" Width="*" CanUserSort="False" Header="일" Binding="{Binding Day}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="FontSize" Value="13"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn IsReadOnly="False" CanUserReorder="False" Width="*" CanUserSort="False" Header="ver." Binding="{Binding Ver}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="FontSize" Value="13"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
