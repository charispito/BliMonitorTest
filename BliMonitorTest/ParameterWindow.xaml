<Window x:Class="BliMonitorTest.ParameterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BliMonitorTest"
        mc:Ignorable="d"
        Title="BLI 모니터링 프로그램 - 파라미터 설정"
        Height="900"
        Width="1703"
        SizeToContent="WidthAndHeight"
        Background="Transparent">

    <Window.Resources>
        <!-- 섹션 타이틀 -->
        <Style x:Key="SectionTitleStyle" TargetType="Label">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- DataGrid 공통 스타일 (ParameterWindow에서 사용하는 GridStyle 키 제공) -->
        <Style x:Key="GridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FBFDFF"/>

            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource SoftBorderBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource SoftBorderBrush}"/>

            <Setter Property="BorderBrush" Value="{StaticResource SoftBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="HeadersVisibility" Value="None"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="SelectionMode" Value="Single"/>

            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderBrush" Value="{StaticResource SoftBorderBrush}"/>
                        <Setter Property="BorderThickness" Value="0.5"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </Setter.Value>
            </Setter>

            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="MinHeight" Value="28"/>
                        <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource Self}, Path=Background}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EAF4FF"/>
                                <Setter Property="Foreground" Value="#111827"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ✅ 바깥 배경 -->
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1169*"/>
            <ColumnDefinition Width="358*"/>
            <ColumnDefinition Width="73*"/>
        </Grid.ColumnDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Grid.ColumnSpan="3">

            <!-- 바깥 여백 -->
            <Grid Margin="18" ShowGridLines="False">

                <!-- ✅ 전체 프레임 카드 -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                    <Grid ShowGridLines="False">

                        <!-- ===== 원본 Grid 구조 유지 ===== -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1140"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="20"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                        </Grid.RowDefinitions>

                        <!-- =========================
                             좌측: 검사 항목 설정 섹션(카드)
                        ========================== -->
                        <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="3" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Content="검사 항목 설정" Style="{StaticResource SectionTitleStyle}"/>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="OpenErrorDataQueryButton" Content="에러이력 조회" Width="150" Height="28" Margin="0,0,20,0" Style="{StaticResource OutlineBlueButtonStyle}"/>
                                </StackPanel>

                                <!-- Error 라벨 줄 -->
                                <!-- 라벨줄: 5열 균등, 좌우 여백 약간 -->
                                <Grid Grid.Row="1" HorizontalAlignment="Stretch" Margin="0,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label FontSize="14" Content="Error1" FontWeight="Black" HorizontalContentAlignment="Center"/>
                                    <Label FontSize="14" Grid.Column="1" Content="Error2" FontWeight="Black" HorizontalContentAlignment="Center"/>
                                    <Label FontSize="14" Grid.Column="2" Content="Error3" FontWeight="Black" HorizontalContentAlignment="Center"/>
                                    <Label FontSize="14" Grid.Column="3" Content="Error4" FontWeight="Black" HorizontalContentAlignment="Center"/>
                                    <Label FontSize="14" Grid.Column="4" Content="Error5" FontWeight="Black" HorizontalContentAlignment="Center"/>
                                </Grid>

                                <!-- ErrorGrid: 폭 고정 대신 Stretch, 마지막에 여백 -->
                                <DataGrid Grid.Row="2" Style="{StaticResource GridStyle}" HorizontalAlignment="Stretch" Margin="0,4,8,0" BorderThickness="1" HeadersVisibility="None" CanUserAddRows="False" HorizontalScrollBarVisibility="Disabled" AutoGenerateColumns="False" x:Name="ErrorGrid">
                                    <DataGrid.Columns>
                                        <!-- 라벨/값 반복 쌍을 너비 비율로 균등 분배 -->
                                        <DataGridTextColumn IsReadOnly="True"  Width="1.2*" Binding="{Binding Name}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="#CCC"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn IsReadOnly="False" Width="*" Binding="{Binding Value}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn IsReadOnly="True"  Width="1.2*" Binding="{Binding Name}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="#CCC"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn IsReadOnly="False" Width="*" Binding="{Binding Value2}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn IsReadOnly="True"  Width="1.2*" Binding="{Binding Name}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="#CCC"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn IsReadOnly="False" Width="*" Binding="{Binding Value3}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn IsReadOnly="True"  Width="1.2*" Binding="{Binding Name}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="#CCC"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn IsReadOnly="False" Width="*" Binding="{Binding Value4}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn IsReadOnly="True"  Width="1.2*" Binding="{Binding Name}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="#CCC"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- 마지막 값 열: 살짝 더 넓게 1.05*로 여유 부여 -->
                                        <DataGridTextColumn IsReadOnly="False" Width="1.05*" Binding="{Binding Value5}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- =========================
                             우측: 운전 패널(카드)
                        ========================== -->
                        <Border Grid.Row="1" Grid.Column="3" Grid.RowSpan="3" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <Grid Width="200" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Label Content="운전" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6"/>
                                <Label Grid.Row="1" Content="정상 운전" FontSize="15" Margin="0,6,0,6" FontWeight="Black"/>
                                <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{StaticResource SoftBorderBrush}" BorderThickness="1" CornerRadius="10" Background="#FBFDFF" Padding="2" Margin="0,0,33,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Label x:Name="RunCount" BorderThickness="0" FontSize="17" Content="0" HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
                                        <Label Grid.Column="1" Content="회" FontSize="17" Margin="10,0,0,0" VerticalContentAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Button Grid.ColumnSpan="2" Grid.Row="4" Height="34" Margin="0,8,28,38" FontSize="14" Content="READ" x:Name="ReadErrorButton" Style="{StaticResource OutlineBlueButtonStyle}"/>
                                <Button Grid.ColumnSpan="2" Grid.Row="4" Height="34" Margin="0,50,28,0" FontSize="14" Content="RESET" x:Name="ResetErrorButton" Style="{StaticResource OutlineRedButtonStyle}" Grid.RowSpan="2"/>
                            </Grid>
                        </Border>

                        <!-- =========================
                             우측: 파일 패널(카드)
                        ========================== -->
                        <Border Grid.Row="1" Grid.Column="5" Grid.RowSpan="7" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.Resources>
                                    <!-- 행 공통 마진 -->
                                    <Style x:Key="FormRowGrid" TargetType="Grid">
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                    </Style>
                                    <!-- 라벨 스타일 -->
                                    <Style x:Key="FormLabel" TargetType="Label">
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#6B7280"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,8,0"/>
                                        <Setter Property="Height" Value="15"/>
                                    </Style>
                                    <!-- 입력칸 스타일: SoftTextBoxStyle 기반 -->
                                    <Style x:Key="FormTextBox" TargetType="TextBox" BasedOn="{StaticResource SoftTextBoxStyle}">
                                        <Setter Property="Height" Value="32"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    </Style>
                                </Grid.Resources>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <!-- 리스트(가변, 내부 스크롤) -->
                                    <RowDefinition Height="80"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 파일(에러) 제목 -->
                                <Label Grid.Row="0" Content="파일(에러)" Style="{StaticResource SectionTitleStyle}"/>

                                <!-- 파일이름(에러): 1행 2열 -->
                                <Grid Grid.Row="1" Style="{StaticResource FormRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="파일이름" Style="{StaticResource FormLabel}"/>
                                    <TextBox Grid.Column="1" x:Name="ErrorFileName" Style="{StaticResource FormTextBox}"/>
                                </Grid>

                                <!-- 필터(에러): 1행 2열 -->
                                <Grid Grid.Row="2" Style="{StaticResource FormRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="필터" Style="{StaticResource FormLabel}"/>
                                    <TextBox Grid.Column="1" x:Name="ErrorSearchBox" Style="{StaticResource FormTextBox}" TextChanged="ErrorSearchBox_TextChanged"/>
                                </Grid>

                                <!-- 리스트(에러): 고정 높이 + 내부 스크롤 -->
                                <ListBox Grid.Row="3" x:Name="ErrorFileList" Height="140" Style="{StaticResource SoftListBoxStyle}" SelectionMode="Extended" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                            ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <EventSetter Event="MouseDoubleClick" Handler="ErrorListDoubleClick"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>

                                <!-- 버튼(에러) -->
                                <Grid Grid.Row="4" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="저장" x:Name="ErrorSaveButton" Style="{StaticResource SoftButtonStyle}"/>
                                    <Button Grid.Column="2" x:Name="ErrorDeleteButton" Content="삭제" Style="{StaticResource SoftButtonStyle}"/>
                                    <Button Grid.Column="4" x:Name="ErrorRefreshButton" Content="새로고침" Style="{StaticResource SoftButtonStyle}"/>
                                </Grid>

                                <!-- 구분선 -->
                                <Border Grid.Row="5" Height="1" Background="#E5E7EB" Margin="0,3,0,3"/>

                                <!-- 파일(파라미터) 제목 -->
                                <Label Grid.Row="6" Content="파일(파라미터)" Style="{StaticResource SectionTitleStyle}"/>

                                <!-- 파일이름(파라미터): 1행 2열 -->
                                <Grid Grid.Row="7" Style="{StaticResource FormRowGrid}" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="파일이름" Style="{StaticResource FormLabel}"/>
                                    <TextBox Grid.Column="1" x:Name="FileName" Style="{StaticResource FormTextBox}"/>
                                </Grid>

                                <!-- 필터(파라미터): 1행 2열 -->
                                <Grid Grid.Row="8" Style="{StaticResource FormRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="필터" Style="{StaticResource FormLabel}"/>
                                    <TextBox Grid.Column="1" x:Name="FileSearchBox" Style="{StaticResource FormTextBox}" TextChanged="FileSearchBox_TextChanged"/>
                                </Grid>

                                <!-- 리스트(파라미터): 고정 높이 + 내부 스크롤 -->
                                <ListBox Grid.Row="9" x:Name="FileList" Height="500" Style="{StaticResource SoftListBoxStyle}" SelectionMode="Extended" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <EventSetter Event="MouseDoubleClick" Handler="ListDoubleClick"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>

                                <!-- 버튼(파라미터) -->
                                <Grid Grid.Row="10" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="저장" x:Name="SaveButton" Style="{StaticResource SoftButtonStyle}"/>
                                    <Button Grid.Column="2" x:Name="DeleteButton" Content="삭제" Style="{StaticResource SoftButtonStyle}"/>
                                    <Button Grid.Column="4" x:Name="RefreshButton" Content="새로고침" Style="{StaticResource SoftButtonStyle}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- =========================
                             중단: Micom Parameter 섹션 타이틀(카드 밖에서 정렬 유지)
                        ========================== -->
                        <Label Grid.Row="4" Grid.Column="1" Content="Micom Parameter" Style="{StaticResource SectionTitleStyle}" Margin="0,6,0,10"/>

                        <!-- =========================
                             Micom Parameter 메인 그리드(카드)
                             - 내부 컨트롤/배치는 원본 그대로 유지
                        ========================== -->
                        <Border Grid.Row="5" Grid.Column="1" Grid.RowSpan="2" Grid.ColumnSpan="3" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">

                            <!-- ✅ 원본 Grid 그대로 복사 -->
                            <Grid ShowGridLines="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label FontSize="15" Content="Mode1" FontWeight="Black"/>
                                <Label FontSize="15" Grid.Column="1" Content="Mode2" FontWeight="Black"/>
                                <Label FontSize="15" Grid.Column="2" Content="Mode3" FontWeight="Black"/>
                                <Label FontSize="15" Grid.Row="2" Content="Mode4" FontWeight="Black"/>
                                <Label FontSize="15" Grid.Row="2" Grid.Column="1" Content="Mode5" FontWeight="Black"/>
                                <Label FontSize="15" Grid.Row="2" Grid.Column="2" Content="Motor" FontWeight="Black"/>

                                <DataGrid Style="{StaticResource GridStyle}" Grid.Row="1" BorderThickness="2,2,0,0" Height="Auto" HeadersVisibility="None" CanUserAddRows="False" HorizontalScrollBarVisibility="Disabled" AutoGenerateColumns="False" x:Name="MicomGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn IsReadOnly="True" CanUserReorder="False" Width="2*" CanUserSort="False" Binding="{Binding Name}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="#CCC"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="False" CanUserReorder="False" Width="*" CanUserSort="False" Binding="{Binding Value}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <DataGrid Style="{StaticResource GridStyle}" Grid.Row="1" Grid.Column="1" BorderThickness="0,2,0,0" Height="Auto" HeadersVisibility="None" CanUserAddRows="False" HorizontalScrollBarVisibility="Disabled" AutoGenerateColumns="False" x:Name="MicomGrid2">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn IsReadOnly="True" CanUserReorder="False" Width="2*" CanUserSort="False" Binding="{Binding Name}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="#CCC"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn IsReadOnly="False" CanUserReorder="False" Width="*" CanUserSort="False" Binding="{Binding Value}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <DataGrid Style="{StaticResource GridStyle}" Grid.Row="1" Grid.Column="2" BorderThickness="0,2,0,0" Height="Auto" HeadersVisibility="None" CanUserAddRows="False" HorizontalScrollBarVisibility="Disabled" AutoGenerateColumns="False" x:Name="MicomGrid3">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn IsReadOnly="True" CanUserReorder="False" Width="2*" CanUserSort="False" Binding="{Binding Name}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="#CCC"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                </Style>
